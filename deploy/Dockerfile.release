FROM python:3.12-slim-bookworm
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY wheelhouse /wheelhouse
RUN cd /wheelhouse && sha256sum -c SHA256SUMS && pip install --no-cache-dir --no-index --find-links=/wheelhouse btc-signal-research-os && rm -rf /wheelhouse
COPY --chmod=0644 alembic.ini ./
COPY --chmod=0755 alembic ./alembic
USER 10001:10001
CMD ["python", "-m", "research_os.cli", "live"]
