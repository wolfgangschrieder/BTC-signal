# Generate a hexadecimal password on the VPS: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEXADECIMAL_PASSWORD
# Keep false during data collection and model validation.
SIGNAL_EMISSION_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# High-frequency raw and normalized data; 0 disables cleanup.
RAW_RETENTION_HOURS=6

# Decimal GB; compose probes the PostgreSQL volume every 10 seconds.
STORAGE_MAX_DATABASE_GB=18
STORAGE_MIN_FREE_GB=5

# Read existing macro observations; does not fetch external data automatically.
CROSS_MARKET_ENABLED=false
CROSS_MARKET_REFRESH_SECONDS=60
CROSS_MARKET_CACHE_MAX_AGE_SECONDS=120
CROSS_MARKET_MAX_EVENT_AGE_DAYS=7

# Optional isolated analyst. Enter a new API key only on the server.
AUDITOR_ENABLED=false
DEEPSEEK_API_KEY=
AUDITOR_MODEL=deepseek-flash
AUDITOR_DAILY_TOKEN_BUDGET=1000000
AUDITOR_MAX_OUTPUT_TOKENS=2200
AUDITOR_RETENTION_DAYS=7
AUDITOR_TELEGRAM_ENABLED=true
