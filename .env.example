SIGNAL_MIN_EV=0.0
SIGNAL_GUARD_MAX_LATENCY_MS=500
SIGNAL_GUARD_MAX_SPREAD_BPS=10
SIGNAL_GUARD_MAX_ORDERBOOK_AGE_MS=5000

REPORT_TIMEZONE=Europe/Moscow
